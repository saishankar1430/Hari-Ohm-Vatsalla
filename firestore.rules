rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "shubhuusinha777@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == "admin")
      );
    }

    // 1. Users collection
    // Contains patient and admin profiles. Patients can read/write their own.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Settings collection
    // Contains global clinic configurations. Publicly readable, admin editable.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Services collection
    // Services offered by the clinic. Publicly readable, admin editable.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Gallery collection
    // Clinic gallery items. Publicly readable, admin editable.
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Availability collection
    // Doctor availability schedules. Publicly readable, admin editable.
    match /availability/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Notice collection
    // Clinic notice board banner/announcements. Publicly readable, admin editable.
    match /notice/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Reviews collection
    // Clinic patient reviews. Publicly readable, signed-in users can write, admin can approve/delete.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 8. Slots collection
    // Available & booked clinic slots. Publicly readable (so the calendar shows them), writable by signed-in users during booking.
    match /slots/{slotId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 9. Appointments collection
    // Patient appointment documents. Patients can read/write their own.
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.patientId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
